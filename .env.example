# =============================================================================
# BORNERS GROUP — STRATEGY & PRODUCT DEVELOPMENT PLATFORM
# Шаблон переменных окружения (.env.example) — БЕЗ СЕКРЕТОВ (п. 16, 26 ТЗ)
# =============================================================================

# Публичные параметры подключения к Supabase (безопасны для клиента при включённом RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Серверные секреты — ТОЛЬКО НА СЕРВЕРЕ (никогда не добавлять префикс NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-server-only
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# Конфигурация приложения
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_DEFAULT_CURRENCY=RUB
NEXT_PUBLIC_ENABLE_DEMO_MODE=true
